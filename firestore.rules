rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function profileOf(uid) { return get(/databases/$(database)/documents/profiles/$(uid)).data; }
    // غيّر هذا البريد إلى بريد حساب جوجل الخاص بك (أنت صاحب التطبيق)
    function isOwner() {
      return signedIn()
        && request.auth.token.email == "ضع-بريدك-هنا@gmail.com"
        && request.auth.token.email_verified == true;
    }

    // الملفات الشخصية: يقرؤها أي مستخدم مسجّل، وكل شخص يكتب ملفه فقط، والدور لا يتغيّر بعد الحفظ
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create: if request.auth.uid == uid
        && request.resource.data.role in ['rider', 'driver']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60;
      allow update: if request.auth.uid == uid
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // الرحلات: ينشرها السائقون فقط، ويحذف السائق رحلته فقط
    match /trips/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.driverId == request.auth.uid
        && profileOf(request.auth.uid).role == 'driver'
        && request.resource.data.seats is int
        && request.resource.data.seats >= 1 && request.resource.data.seats <= 8;
      allow update: if false;
      allow delete: if resource.data.driverId == request.auth.uid;
    }

    // الحجوزات: يحجز الركاب فقط، ويلغي الراكب حجزه أو يحذفه سائق الرحلة
    match /bookings/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.riderId == request.auth.uid
        && profileOf(request.auth.uid).role == 'rider'
        && request.resource.data.n is int
        && request.resource.data.n >= 1 && request.resource.data.n <= 6;
      allow update: if resource.data.riderId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rated', 'stars']);
      allow delete: if resource.data.riderId == request.auth.uid
        || get(/databases/$(database)/documents/trips/$(resource.data.tripId)).data.driverId == request.auth.uid;
    }

    // النجوم فقط: يراها الجميع لعرض متوسط تقييم السائق
    match /reviews/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.riderId == request.auth.uid
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1 && request.resource.data.stars <= 5;
      allow update, delete: if false;
    }

    // أسباب التقييم وملاحظاته: لا يقرؤها إلا أنت
    match /feedback/{id} {
      allow create: if signedIn()
        && request.resource.data.riderId == request.auth.uid;
      allow read: if isOwner();
      allow update, delete: if false;
    }

    // السائقون المحفوظون: خاصة بكل مستخدم
    match /users/{uid}/prefs/{docId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
